# S3 Gamepad — ESP-IDF 工程忽略规则

# 构建产物
build/
build-*/
sdkconfig.old
sdkconfig.ci

# ESP-IDF 组件管理器（依赖清单 dependencies.lock 需要提交，缓存目录不提交）
managed_components/

# 编辑器 / 系统
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# 原始启动包 / 补充包 / 规划文档的存档目录（内容已并入根目录，仅作参考，不入库）
ESP32-S3_*/
ESP32-S3_%E6*

# 调试产物
*.map
coredump/
gdbinit.local
